import java.util.Scanner;

public class demojava{
    public static void main(String[] args) {
 Scanner scanner = new Scanner(System.in);
       
        System.out.println("Enter first number: ");
        int first = scanner.nextInt();

        System.out.println("Enter second number: ");
        int second = scanner.nextInt();

        
        System.out.println("The addition between two numbers:" + (first + second));
        System.out.println("The subtraction between two numbers:" + (first - second) );
        System.out.println("The multiplication between two numbers:" + (first * second));

        if (second != 0) {
            System.out.println("The division between two numbers:" + (first / second));
        } else {
            System.out.println("Division by zero is not allowed");
            }